<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20240601_000007" author="copilot">
        <createTable tableName="borrow_records">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="borrow_date" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="due_date" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="return_date" type="DATETIME"/>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="download_token" type="VARCHAR(100)"/>
            <column name="token_expired_at" type="DATETIME"/>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="book_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME"/>
            <column name="updated_at" type="DATETIME"/>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_by" type="VARCHAR(100)"/>
        </createTable>

        <addUniqueConstraint tableName="borrow_records" columnNames="download_token" constraintName="uk_borrow_records_download_token"/>
        <addForeignKeyConstraint baseTableName="borrow_records" baseColumnNames="user_id" referencedTableName="users" referencedColumnNames="id" constraintName="fk_borrow_records_user"/>
        <addForeignKeyConstraint baseTableName="borrow_records" baseColumnNames="book_id" referencedTableName="books" referencedColumnNames="id" constraintName="fk_borrow_records_book"/>
    </changeSet>

</databaseChangeLog>
