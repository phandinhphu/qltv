<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20240601_000004" author="copilot">
        <createTable tableName="books">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="isbn" type="VARCHAR(50)">
                <constraints unique="true"/>
            </column>
            <column name="description" type="VARCHAR(4000)"/>
            <column name="cover_image_url" type="VARCHAR(500)"/>
            <column name="file_url" type="VARCHAR(500)"/>
            <column name="publish_year" type="INT"/>
            <column name="language" type="VARCHAR(100)"/>
            <column name="total_copies" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="available_copies" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME"/>
            <column name="updated_at" type="DATETIME"/>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_by" type="VARCHAR(100)"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
