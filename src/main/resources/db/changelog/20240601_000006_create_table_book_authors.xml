<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20240601_000006" author="copilot">
        <createTable tableName="book_authors">
            <column name="book_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="author_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="book_authors" columnNames="book_id, author_id" constraintName="pk_book_authors"/>
        <addForeignKeyConstraint baseTableName="book_authors" baseColumnNames="book_id" referencedTableName="books" referencedColumnNames="id" constraintName="fk_book_authors_book"/>
        <addForeignKeyConstraint baseTableName="book_authors" baseColumnNames="author_id" referencedTableName="authors" referencedColumnNames="id" constraintName="fk_book_authors_author"/>
    </changeSet>

</databaseChangeLog>
