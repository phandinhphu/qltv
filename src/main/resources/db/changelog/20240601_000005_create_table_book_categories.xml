<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20240601_000005" author="copilot">
        <createTable tableName="book_categories">
            <column name="book_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="category_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="book_categories" columnNames="book_id, category_id" constraintName="pk_book_categories"/>
        <addForeignKeyConstraint baseTableName="book_categories" baseColumnNames="book_id" referencedTableName="books" referencedColumnNames="id" constraintName="fk_book_categories_book"/>
        <addForeignKeyConstraint baseTableName="book_categories" baseColumnNames="category_id" referencedTableName="categories" referencedColumnNames="id" constraintName="fk_book_categories_category"/>
    </changeSet>

</databaseChangeLog>
